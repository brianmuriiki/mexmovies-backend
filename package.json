{
  "name": "mexmovies-server",
  "version": "0.2.0",
  "description": "mexMovies API (Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:genres": "node src/scripts/seedGenres.js",
    "seed:levels": "node src/scripts/seedLevels.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed": "node src/scripts/seedGenres.js && node src/scripts/seedLevels.js && node src/scripts/seedAdmin.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "setupFiles": ["./tests/setup.js"],
    "testTimeout": 60000
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
