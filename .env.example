# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database ----------
# MongoDB Atlas M0 connection string, or mongodb://127.0.0.1:27017/mexmovies locally
MONGODB_URI=mongodb://127.0.0.1:27017/mexmovies

# ---------- Auth ----------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
SESSION_DAYS=1
# In production the default is "none" (frontend and API on different domains).
# Use "lax" if the API is proxied through the same domain as the frontend (see DEPLOY.md).
# COOKIE_SAMESITE=lax

# ---------- Frontend ----------
# Frontend origin(s), comma separated. Used for CORS, the origin check, and email links.
CLIENT_ORIGIN=http://localhost:5173
# APP_URL=http://localhost:5173

# ---------- First admin (used only by: npm run seed:admin) ----------
ADMIN_NAME=mexMovies Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# ---------- Uploads to Cloudflare R2 (Phase 4) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mexmovies-videos
# Public address of the bucket, no trailing slash (the r2.dev address, or your custom domain)
R2_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=2147483648
STORAGE_QUOTA_BYTES=10737418240

# ---------- Catalog snapshot (Phase 7) ----------
# Seconds-to-milliseconds delay before rebuilding after a change (batches rapid edits)
SNAPSHOT_DELAY_MS=3000

# ---------- Email: console | resend | brevo ----------
# "console" just prints emails to the server log (fine for development)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=mexMovies <no-reply@example.com>

# ---------- Bot check on sign-up (Cloudflare Turnstile, free) ----------
# Leave empty to switch it off. The frontend sends the widget's token as "turnstileToken".
TURNSTILE_SECRET=

# ---------- Rewards ----------
REWARDS_DAILY_CAP_HOURS=6
REWARDS_FLUSH_SECONDS=60
# Keep false until subscriptions launch
REDEMPTION_ENABLED=false
